{
	"name": "pomoexchange",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"preview": "npm exec vite preview",
		"typecheck": "react-router typegen && tsc",
		"test": "vitest --config=vitest.unit.config.ts",
		"test:run": "vitest run --config=vitest.unit.config.ts",
		"test:browser": "vitest --config=vitest.browser.config.ts",
		"test:browser:headless": "vitest --browser.headless --config=vitest.browser.config.ts",
		"test:browser:run": "vitest run --browser.headless --config=vitest.browser.config.ts",
		"test:all": "npm run test:run && npm run test:browser:run",
		"test:all:coverage": "vitest run --config=vitest.unit.config.ts --coverage && vitest run --config=vitest.browser.config.ts --coverage",
		"prepare": "husky",
		"check": "biome check --write"
	},
	"lint-staged": {
		"**/*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"npm run check"
		]
	},
	"dependencies": {
		"@fontsource-variable/figtree": "^5.2.10",
		"@hugeicons/core-free-icons": "^4.1.2",
		"@hugeicons/react": "^1.1.6",
		"@react-router/node": "7.15.0",
		"@react-router/serve": "7.15.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"isbot": "^5.1.36",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-router": "7.15.0",
		"shadcn": "^4.7.0",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@react-router/dev": "7.15.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/browser-playwright": "^4.1.5",
		"@vitest/coverage-istanbul": "^4.1.5",
		"@vitest/coverage-v8": "^4.1.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.3",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^8.0.3",
		"vitest-browser-react": "^2.2.0"
	}
}
